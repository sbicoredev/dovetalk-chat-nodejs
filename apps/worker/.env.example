NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

DATABASE_URL=postgres://dovetalk:dovetalk@localhost:5432/dovetalk
DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379/0

# Must match the API's. It starts the name of every queue key in Redis.
QUEUE_PREFIX=dovetalk

# File storage: the same store as the API (see apps/api/.env.example). The worker removes the
# files of expired guests and orphan uploads. It never makes the bucket, the API does.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=dovetalk
S3_ACCESS_KEY_ID=dovetalk
S3_SECRET_ACCESS_KEY=dovetalk-secret
S3_FORCE_PATH_STYLE=true

# ---- Jobs ---------------------------------------------------------------------------------
# Bot-reply jobs this process runs at once. They are mostly waiting, so the default is generous.
BOT_REPLY_CONCURRENCY=25
# How often (milliseconds) each housekeeping job runs. Every replica registers the same schedule
# and Redis keeps one of it, so a job runs once per period however many replicas there are.
CLEANUP_GUESTS_EVERY_MS=600000
CLEANUP_STATUSES_EVERY_MS=600000
CLEANUP_ATTACHMENTS_EVERY_MS=3600000
CLEANUP_TOKENS_EVERY_MS=3600000
# An upload that no message and no profile photo uses is removed after this long (24 hours).
ORPHAN_ATTACHMENT_AGE_MS=86400000
# Rows one cleanup batch takes. A run repeats batches until one is not full.
CLEANUP_BATCH_SIZE=100

# Beside the jobs, the worker serves health probes here.
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3002

SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000

# ---- Telemetry (OpenTelemetry) --------------------------------------------------------------
# Off unless an OTLP endpoint is set (it costs about 1.5x the CPU per message with a Collector, about
# 1.3x with none, see docs/observability.md). Run the observability stack with
# `docker compose --profile observability up -d` and point at its Collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# How often metrics are sent (milliseconds).
# OTEL_METRIC_EXPORT_INTERVAL=10000
# Keep a share of the traces: parentbased_traceidratio with OTEL_TRACES_SAMPLER_ARG=0.1 keeps 10%.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=
# Off even when an endpoint is set. TELEMETRY_ENABLED=true turns it on with the default endpoint.
# TELEMETRY_ENABLED=false
# After an export fails, skip the next ones for this long (milliseconds, 0 = never skip). Keeps an
# unreachable Collector from holding memory.
# TELEMETRY_EXPORT_COOLDOWN_MS=30000
# Standard batch settings, the most spans / log records waiting to be sent (default 2048 each).
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BLRP_MAX_QUEUE_SIZE=2048
# Shows what the SDK itself reports (errors, dropped spans): error, warn, info or debug.
# OTEL_LOG_LEVEL=
