NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgres://dovetalk:dovetalk@localhost:5432/dovetalk
# Connections per process. Total = this x the number of API and worker instances.
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# Web app origins allowed to call the API, comma separated. No trailing slashes.
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API ("false" when exposed directly). 1 when the web app
# proxies /api to it, so rate limits see the visitor and not the web server.
TRUST_PROXY=false

# ---- File storage (S3 API) ----------------------------------------------------------------
# Any S3-compatible store: SeaweedFS from `docker compose up -d` here, Cloudflare R2 or S3 in
# production. The values below match ops/docker/seaweedfs-s3.json, which is for local use only.
# What the server talks to. Inside Compose this is http://s3:8333.
S3_ENDPOINT=http://localhost:8333
# What browsers are sent in signed links, so it must be reachable from outside. Defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=dovetalk
S3_ACCESS_KEY_ID=dovetalk
S3_SECRET_ACCESS_KEY=dovetalk-secret
# http://host/bucket/key instead of http://bucket.host/key. SeaweedFS needs it, R2 accepts it.
S3_FORCE_PATH_STYLE=true
# Make the bucket at start if it is missing, waiting up to a minute for the store to come up.
# For local development and CI. Leave off in production, where the bucket is set up by hand.
S3_CREATE_BUCKET=true

# ---- Authentication --------------------------------------------------------------------
# Signs access tokens. Every API instance must share it. Generate one: openssl rand -base64 48
# Production refuses a value that starts with "dev-only".
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A rotated refresh token is still accepted this long, for two tabs refreshing at once.
REFRESH_REUSE_WINDOW_MS=10000
# How long the auth guard remembers that a user still exists. 0 asks the database every time.
AUTH_CACHE_TTL_MS=30000

# The refresh-token cookie. The defaults suit a web app and API on the same site.
# When the web app serves the API under its own /api path (NEXT_PUBLIC_API_URL=/api, the setup the
# Compose file uses) set COOKIE_PATH=/api/auth, so the browser sends the cookie to /api/auth/refresh.
# Leave /auth when the browser calls the API directly.
# COOKIE_SECURE defaults to true in production. Safari ignores Secure cookies on http://localhost.
COOKIE_SAMESITE=lax
COOKIE_PATH=/auth
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# ---- Realtime presence (all optional; the defaults suit production) -----------------------
# Each API instance refreshes the connections it holds this often.
# PRESENCE_HEARTBEAT_MS=15000
# A connection not refreshed for this long is treated as gone, which is how the people of a
# crashed instance go offline. Must be at least twice the heartbeat.
# PRESENCE_SOCKET_TTL_MS=45000
# After somebody's last connection closes, wait this long before saying they are offline, so a
# page reload does not flap. 0 announces at once.
# PRESENCE_OFFLINE_DEBOUNCE_MS=5000
# How often each instance looks for people whose time is up.
# PRESENCE_SWEEP_MS=1000

# ---- Background jobs ----------------------------------------------------------------------
# Bots answer through jobs that apps/worker runs, so the worker must be running too. Both use
# the same QUEUE_PREFIX, which starts the name of every queue key in Redis. Change it only to
# share one Redis between several deployments.
QUEUE_PREFIX=dovetalk
# Whether a message to a bot adds the jobs that make it answer. Set false to run the API with
# no worker, so nothing piles up in Redis.
BOT_REPLIES_ENABLED=true

# ---- Rate limits (per client IP unless noted) -------------------------------------------
# RATE_LIMIT_GLOBAL=600         per route, per minute
# RATE_LIMIT_LOGIN_IP=20        per minute
# RATE_LIMIT_LOGIN_EMAIL=10     per 15 minutes, against one email from anywhere
# RATE_LIMIT_REGISTER=20        per hour
# RATE_LIMIT_GUEST=30           per hour
# RATE_LIMIT_REFRESH=60         per minute

# ---- Seeding (pnpm db:seed) -------------------------------------------------------------
# Creates demo@dovetalk.app. Its password is public, so leave this off on any shared server.
SEED_DEMO_ACCOUNT=true

# Show the OpenAPI page at /docs. Defaults to on outside production.
SWAGGER_ENABLED=true

# After SIGTERM, fail readiness for this long before closing. Set ~5000 behind a load balancer.
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000

# ---- Telemetry (OpenTelemetry) --------------------------------------------------------------
# Off unless an OTLP endpoint is set (it costs about 1.5x the CPU per message with a Collector, about
# 1.3x with none, see docs/observability.md). Run the observability stack with
# `docker compose --profile observability up -d` and point at its Collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# How often metrics are sent (milliseconds).
# OTEL_METRIC_EXPORT_INTERVAL=10000
# Keep a share of the traces: parentbased_traceidratio with OTEL_TRACES_SAMPLER_ARG=0.1 keeps 10%.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=
# Off even when an endpoint is set. TELEMETRY_ENABLED=true turns it on with the default endpoint.
# TELEMETRY_ENABLED=false
# After an export fails, skip the next ones for this long (milliseconds, 0 = never skip). Keeps an
# unreachable Collector from holding memory.
# TELEMETRY_EXPORT_COOLDOWN_MS=30000
# Standard batch settings, the most spans / log records waiting to be sent (default 2048 each).
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BLRP_MAX_QUEUE_SIZE=2048
# Shows what the SDK itself reports (errors, dropped spans): error, warn, info or debug.
# OTEL_LOG_LEVEL=
