{
  "name": "@dovetalk/api",
  "version": "0.0.0",
  "private": true,
  "description": "Dovetalk HTTP and socket.io API.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "node --watch --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main.js",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "db:seed": "node --env-file-if-exists=.env dist/cli/seed.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary --coverage.include=src/**"
  },
  "dependencies": {
    "@dovetalk/contracts": "workspace:*",
    "@dovetalk/core": "workspace:*",
    "@dovetalk/db": "workspace:*",
    "@dovetalk/telemetry": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dovetalk/testkit": "workspace:*",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "pino-pretty": "latest",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
