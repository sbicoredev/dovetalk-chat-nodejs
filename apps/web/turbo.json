{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_PROXY_TARGET", "NEXT_STANDALONE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!e2e/**",
        "!coverage/**",
        "!playwright-report/**",
        "!test-results/**"
      ]
    }
  }
}
