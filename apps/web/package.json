    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
