# These are read when the app is built (`next dev` or `next build`), not when it starts.
# Restart the dev server after changing them.

# Leave NEXT_PUBLIC_API_URL empty to run on the in-browser mock server (demo data, no backend).
# To use the real API from this repository, set it to /api and set API_PROXY_TARGET below: the
# browser then calls the API through this app, which keeps the sign-in cookie first-party.
# (A full URL such as http://localhost:3001 also works if the API allows this origin and sets
# COOKIE_SAMESITE=none, COOKIE_SECURE=true: browsers may block that cookie as a third party's.)
NEXT_PUBLIC_API_URL=
# Where the browser opens the socket: it connects straight to the API, with the access token.
# Needed when NEXT_PUBLIC_API_URL is a path such as /api.
NEXT_PUBLIC_WS_URL=
# Where this web server reaches the API, for the /api rewrite. Needed when NEXT_PUBLIC_API_URL is /api.
# In Docker Compose it is http://api:3001.
API_PROXY_TARGET=

# With the real API behind /api, the API must set  COOKIE_PATH=/api/auth  so the browser sends the
# cookie to /api/auth/refresh. Its CORS_ORIGINS must list this app's origin (the socket and the
# refresh call send an Origin header).

# Mock mode only: the longest simulated network delay, in milliseconds. 0 turns it off.
NEXT_PUBLIC_MOCK_LATENCY_MS=220
