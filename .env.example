# Copy to .env. Docker Compose reads it, and so do the apps when run with `pnpm dev`.
# Nothing here is a secret. These are local development defaults.

POSTGRES_USER=dovetalk
POSTGRES_PASSWORD=dovetalk
POSTGRES_DB=dovetalk

# Object storage image, for uploads and profile photos. Pin a version tag after checking Docker
# Hub for the current release (never :latest). The credentials are in ops/docker/seaweedfs-s3.json.
S3_IMAGE=chrislusf/seaweedfs:4.54
# The port the browser reaches storage on. Signed file links point at http://localhost:<this>.
S3_PORT=8333

# Signs access tokens in the containerised API (docker compose --profile app). Local use only:
# generate a real one for anything else with  openssl rand -base64 48
JWT_SECRET=local-compose-only-change-me-0123456789abcdefgh
# Creates demo@dovetalk.app (password in the README) when the stack starts.
SEED_DEMO_ACCOUNT=true

# ---- Background jobs (docker compose --profile app) ---------------------------------------
# The worker answers for the bots and does the housekeeping. Everything here is optional and
# empty means "use the default". Scale it with  docker compose --profile app up -d --scale worker=2
# Starts the name of every queue key in Redis. The API and the worker must share it; change it
# only to run several deployments against one Redis.
# QUEUE_PREFIX=dovetalk
# Set false to run the API with no worker: a message to a bot then adds no job.
# BOT_REPLIES_ENABLED=true
# Bot-reply jobs one worker runs at once.
# BOT_REPLY_CONCURRENCY=25
# How often (milliseconds) each housekeeping job runs.
# CLEANUP_GUESTS_EVERY_MS=600000
# CLEANUP_STATUSES_EVERY_MS=600000
# CLEANUP_ATTACHMENTS_EVERY_MS=3600000
# CLEANUP_TOKENS_EVERY_MS=3600000
# An upload no message uses is removed after this long (default 24 hours).
# ORPHAN_ATTACHMENT_AGE_MS=86400000
# Rows one cleanup batch takes.
# CLEANUP_BATCH_SIZE=100

# ---- End-to-end and conformance tests (docker compose --profile app) ------------------------
# Every test signs up its own people, so raise the sign-up, guest and sign-in limits before you run
# `pnpm --filter @dovetalk/web test:e2e` or `test:conformance` against this stack. Empty means the default.
# RATE_LIMIT_GLOBAL=1000000
# RATE_LIMIT_LOGIN_IP=1000000
# RATE_LIMIT_LOGIN_EMAIL=1000000
# RATE_LIMIT_REGISTER=1000000
# RATE_LIMIT_GUEST=1000000
# RATE_LIMIT_REFRESH=1000000

# ---- Observability (docker compose --profile observability) -------------------------------
# Grafana (http://localhost:3030), Tempo, Loki, Prometheus and the OpenTelemetry Collector. See
# docs/observability.md. The API and the worker send nothing until they are given an endpoint:
# telemetry costs about 1.5x the API's CPU per message sent with a Collector, and about 1.3x with none
# (measured on one small machine, docs/observability.md), so it is off unless asked for. Uncomment the
# next line, or put it in front of the command:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318 docker compose --profile app --profile observability up -d
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Send to Grafana Cloud instead of the Collector (see docs/observability.md for the caveat):
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>
# Keep a share of the traces, 0.1 = 10%. One message send makes about 98 spans. A trace is kept or
# dropped as a whole, and the rate and error panels count only the kept ones.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Off even when an endpoint is set.
# TELEMETRY_ENABLED=false
# After an export to the Collector fails, skip the next ones for this long (milliseconds, 0 = never skip).
# TELEMETRY_EXPORT_COOLDOWN_MS=30000
# Spans and log records waiting to be sent, at most (the OpenTelemetry default is 2048 each).
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BLRP_MAX_QUEUE_SIZE=2048
# Image tags, if you want another version.
# OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.165.0
# TEMPO_IMAGE=grafana/tempo:3.1.1
# PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
# LOKI_IMAGE=grafana/loki:3.7.10
# GRAFANA_IMAGE=grafana/grafana:13.3.1
# POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.20.1
# REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.97.0

# ---- Scale-out profile (docker compose --profile scale) -------------------------------------
# See docs/scaling.md. These are the defaults; uncomment to change them.
# API_REPLICAS=3
# WORKER_REPLICAS=2
# Host ports the API replicas are published on, one each. At least as many ports as replicas.
# API_DIRECT_PORTS=3101-3103
# LB_PORT=8080
# NGINX_IMAGE=nginx:1.30-alpine
# The scale profile sets every RATE_LIMIT_* to 10000000 unless given here. Never expose it.
